# Copy to .env for local dev. Never commit the real .env file.
# In Azure, these are resolved via Key Vault + Managed Identity instead
# of env vars — see src/core/security.py.

# --- Environment ---
ENVIRONMENT=local              # local | dev | prod
LOG_LEVEL=INFO

# --- Storage (Azurite locally, real Blob Storage in Azure) ---
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
BLOB_CONTAINER_RAW_INVOICES=raw-invoices

# --- Cosmos DB (emulator locally) ---
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=invoice_platform
COSMOS_CONTAINER_INVOICES=invoices
COSMOS_CONTAINER_AUDIT=audit-log

# --- Document Intelligence (F0 free tier is fine to start) ---
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# --- LLM provider: "ollama" for local dev, "azure_openai" for prod/demo ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Prefer Managed Identity / Entra ID auth over a key in Azure; key is
# only for local testing against a real Azure OpenAI resource.
AZURE_OPENAI_API_KEY=

# --- Mock SAP service ---
MOCK_SAP_BASE_URL=http://localhost:8100

# --- Snowflake (leave blank locally; ETL falls back to local Postgres) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
LOCAL_ANALYTICS_DSN=postgresql://postgres:postgres@localhost:5433/analytics

# --- Key Vault (unused locally; Managed Identity resolves this in Azure) ---
KEY_VAULT_URL=

# --- Auth (Entra ID app registration) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
OAUTH2_AUDIENCE=

# --- Observability ---
OTEL_SERVICE_NAME=invoice-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001
