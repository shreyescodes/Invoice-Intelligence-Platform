# Optional overrides for `docker compose` (copy to .env). Every value has a working default.

# Runtime
ENVIRONMENT=development           # development | production (production refuses demo mode and default secrets)
DEMO_MODE=true                    # show demo accounts on the sign-in page
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LOG_LEVEL=INFO

# Database passwords (only used when the Postgres volume is first created)
POSTGRES_PASSWORD=iip
READONLY_PASSWORD=readonly

# ERP
ERP_API_KEY=dev-erp-key
ERP_FAILURE_RATE=0                # 0-1: make the mock ERP return random 503s to exercise retries

# Natural-language analytics (Ask page). With `--profile llm` this points at the bundled Ollama.
LLM_PROVIDER=none                 # none | openai | azure_openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
